# ===== DeepSeek（必填） =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 服务 =====
APP_HOST=0.0.0.0
APP_PORT=8000
# 允许的前端来源，多个用逗号分隔；* 表示全部（开发用）
ALLOWED_ORIGINS=*

# ===== 知识库 =====
KB_DIR=data/kb
# 本地中文 embedding 模型（首次运行自动下载）
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DEVICE=cpu
# 检索返回的片段数量
TOP_K=4

# ===== 日志 =====
LOG_LEVEL=INFO
